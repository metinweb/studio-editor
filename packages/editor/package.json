{
  "name": "studio-editor",
  "version": "0.1.0-beta.12",
  "description": "Independent Vue 3 rich text editor with tables, media management and image editing",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": "metinweb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metinweb/studio-editor.git",
    "directory": "packages/editor"
  },
  "homepage": "https://metinweb.github.io/studio-editor/",
  "bugs": {
    "url": "https://github.com/metinweb/studio-editor/issues"
  },
  "main": "./dist/studio-editor.js",
  "module": "./dist/studio-editor.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/studio-editor.js"
    },
    "./style.css": "./dist/studio-editor.css",
    "./browser": {
      "types": "./index.d.ts",
      "import": "./dist/browser/studio-editor.js"
    },
    "./browser/style.css": "./dist/browser/studio-editor.css",
    "./lite": {
      "types": "./index.d.ts",
      "import": "./dist/lite/studio-editor.js"
    },
    "./lite/style.css": "./dist/lite/studio-editor.css",
    "./lite/browser": {
      "types": "./index.d.ts",
      "import": "./dist/lite/browser/studio-editor.js"
    },
    "./lite/browser/style.css": "./dist/lite/browser/studio-editor.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "README.tr.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "dependency-inventory.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.5.0",
    "pinia": "^3.0.0 || ^4.0.0"
  },
  "keywords": [
    "vue",
    "editor",
    "wysiwyg",
    "rich-text",
    "image-editor"
  ]
}
